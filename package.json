{
  "name": "pi-model-fallback",
  "version": "0.5.10",
  "description": "Pi extension that switches to a fallback model after provider failures such as 429 rate limits.",
  "type": "module",
  "license": "MIT",
  "author": "Keisu",
  "keywords": [
    "pi-package",
    "pi",
    "model-fallback",
    "fallback",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-model-fallback.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-model-fallback/issues"
  },
  "homepage": "https://github.com/eiei114/pi-model-fallback#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs",
    "ci": "npm run typecheck && npm test && npm run smoke:pi && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^26.6.3",
    "@types/proper-lockfile": "4.1.4",
    "jiti": "^2.7.0",
    "typebox": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
